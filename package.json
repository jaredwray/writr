{
  "name": "writr",
  "version": "6.1.6",
  "description": "Markdown Rendering Simplified",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "main": "./dist/writr.mjs",
  "types": "./dist/writr.d.mts",
  "exports": {
    ".": {
      "types": "./dist/writr.d.mts",
      "import": "./dist/writr.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaredwray/writr.git"
  },
  "homepage": "https://github.com/jaredwray/writr#readme",
  "bugs": {
    "url": "https://github.com/jaredwray/writr/issues"
  },
  "author": "Jared Wray <me@jaredwray.com>",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "html",
    "renderer",
    "markdown-to-html",
    "toc",
    "table-of-contents",
    "emoji",
    "syntax-highlighting",
    "markdown-processor",
    "github-flavored-markdown",
    "gfm",
    "remark-plugin",
    "rehype-plugin",
    "markdown-editor",
    "content-management",
    "documentation-tool",
    "blogging",
    "markdown-extension",
    "seo-friendly",
    "markdown-anchors",
    "remark",
    "rehype",
    "react",
    "react-component",
    "react-markdown",
    "markdown-to-react"
  ],
  "scripts": {
    "clean": "rimraf ./dist ./coverage ./node_modules ./pnpm-lock.yaml ./site/README.md ./site/dist",
    "build": "tsdown src/writr.ts --format esm --dts",
    "prepublishOnly": "pnpm build",
    "lint": "biome check --write --error-on-warnings",
    "benchmark:native": "tsx benchmark/benchmark-native-comparison.ts",
    "benchmark": "tsx benchmark/benchmark-minimal.ts && tsx benchmark/benchmark-standard.ts",
    "test": "pnpm lint && vitest run --coverage",
    "test:ci": "biome check --error-on-warnings && vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "build:rs": "cargo build --locked --release --manifest-path writr-rs/Cargo.toml -p writr-node && node writr-rs/tools/copy-node-artifact.mjs",
    "build:rs:wasm": "node writr-rs/tools/build-wasm.mjs",
    "build:rs:pgo": "node writr-rs/tools/build-pgo.mjs",
    "corpus:fetch": "tsx test/harness/fetch/fetcher.ts",
    "corpus:fetch:offline": "tsx test/harness/fetch/fetcher.ts --offline",
    "golden:generate": "tsx test/harness/generate-goldens.ts",
    "golden:check": "tsx test/harness/generate-goldens.ts --check && tsx test/harness/generate-exact.ts --check",
    "website:build": "rimraf ./site/README.md ./site/dist && pnpm docula build",
    "website:serve": "rimraf ./site/README.md ./site/dist && pnpm docula dev",
    "test:bindings": "vitest run --config vitest.bindings.config.ts",
    "golden:exact:generate": "tsx test/harness/generate-exact.ts",
    "golden:exact:check": "tsx test/harness/generate-exact.ts --check",
    "test:bindings:mdx": "vitest run --config vitest.bindings.config.ts test/bindings/mdx.test.ts"
  },
  "dependencies": {
    "ai": "^7.0.93",
    "cacheable": "^2.5.0",
    "hashery": "^3.0.1",
    "hookified": "^3.0.3",
    "html-react-parser": "^6.1.7",
    "js-yaml": "^5.4.1",
    "react": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-toc": "^9.0.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@biomejs/biome": "^2.5.12",
    "@monstermann/tinybench-pretty-printer": "^0.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "docula": "^3.0.0",
    "dotenv": "^17.3.1",
    "markdown-it": "^15.0.1",
    "marked": "^18.0.12",
    "property-information": "7.2.0",
    "rimraf": "^6.1.3",
    "tinybench": "^6.1.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
