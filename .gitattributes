# Keep the tree LF-only. GitHub-hosted windows-latest runners default to
# core.autocrlf=true, and actions/checkout v7 no longer overrides that, which
# made the writr-rs golden harness diverge on CRLF markdown.
* text=auto eol=lf

# Oracle fixtures are byte contracts on every host.
test/harness/** text eol=lf
writr-rs/crates/*/tests/fixtures/** text eol=lf

# Downloads retain the exact upstream bytes, including committed CRLF content.
# Applying text normalization here makes a fresh checkout appear modified.
test/harness/fetch/cache/** -text
